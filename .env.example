# ===== AI Agent (Claude) =====
# Lấy API key tại https://console.anthropic.com  (hoặc chạy `ant auth login`)
ANTHROPIC_API_KEY=
# Model mặc định cho AI Agent
AGENT_MODEL=claude-opus-5-5
# Mức "nỗ lực" suy luận: low | medium | high | xhigh | max
AGENT_EFFORT=medium

# ===== Dữ liệu thị trường =====
# auto  = dữ liệu thật (KBS, Vietcap, VNDirect, CafeF…); giá lỗi hết thì tạm dùng DEMO (gắn nhãn, không cho đặt lệnh);
#         BCTC không lấy được thì để trống (KHÔNG bao giờ bịa số liệu)
# live  = chỉ dùng dữ liệu thật (báo lỗi nếu không lấy được)
# demo  = luôn dùng dữ liệu mô phỏng (để học / thử nghiệm)
DATA_MODE=auto

# Nguồn CHÍNH THỨC (tùy chọn, ổn định hơn API công khai) - cần tài khoản tại công ty chứng khoán:
#  • SSI FastConnect: mở tài khoản SSI → đăng ký dịch vụ API → lấy ConsumerID/ConsumerSecret trên iBoard
#  • DNSE OpenAPI: tài khoản DNSE → đăng ký LightSpeed/OpenAPI tại developers.dnse.com.vn
SSI_API_KEY=
SSI_API_SECRET=
DNSE_API_KEY=
DNSE_API_SECRET=
# Thời gian cache dữ liệu giá (giây)
PRICE_CACHE_TTL=900

# ===== Giao dịch =====
# Vốn khởi tạo cho tài khoản giao dịch giấy (paper trading), đơn vị VND
PAPER_INITIAL_CASH=500000000
# Cho phép đặt lệnh thật qua công ty chứng khoán (mặc định TẮT).
# Chỉ bật khi bạn đã cài đặt adapter broker trong backend/app/trading/broker.py
ALLOW_LIVE_TRADING=false

# Nơi lưu cơ sở dữ liệu SQLite
DB_PATH=backend/data/autotrading.sqlite3

# ===== Truy cập =====
# 127.0.0.1 = chỉ máy này (mặc định). 0.0.0.0 = cho điện thoại cùng Wi-Fi truy cập (vẫn phải đăng nhập)
HOST=127.0.0.1
PORT=8000
